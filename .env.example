# Server
NODE_ENV=development
ENV=development
SERVICE_NAME=lookit-api
SERVER_PORT=3007
PORT=3007

# JWT
JWT_SECRET=change-me-lookit-jwt-secret

# Database — existing docker postgres-18 on host :5433 (same as orbit)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@127.0.0.1:5433/lookit?sslmode=disable

# Redis (local host)
REDIS_URL=redis://127.0.0.1:6379

# Logging
CONSOLE_LOG_LEVEL=debug
FILE_LOG_LEVEL=error

# SMTP — replace with real values later; dummy OK for local boot
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=dummy@lookit.studio
SMTP_PASSWORD=dummy-smtp-password
MAIL_FROM=Lookit <noreply@lookit.studio>

# Local multer temp / small file registry (not event media)
FILE_STORAGE_ENDPOINT=http://localhost:3007/files
FILE_STORAGE_PATH=./files

# Media object store: s3 (now) | r2 (later — same API, flip this flag)
MEDIA_STORAGE_PROVIDER=s3

# AWS — Rekognition + photo media while on S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BACKUP_BUCKET=lookit-backups-dev
AWS_S3_MEDIA_BUCKET=lookit-media-dev
# Optional CDN/public base; defaults to https://{bucket}.s3.{region}.amazonaws.com
AWS_S3_PUBLIC_BASE_URL=

# Cloudflare R2 — fill these and set MEDIA_STORAGE_PROVIDER=r2 when ready
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lookit-media-dev
R2_PUBLIC_BASE_URL=https://media.lookit.studio

# App URLs (prod: lookit.studio / api.lookit.studio)
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3007
CORS_ORIGINS=http://localhost:5173

# Admin bootstrap
ADMIN_EMAIL=yashchauhan1775@gmail.com

# Face (Phase 1)
FACE_ENGINE=rekognition
FACE_MATCH_THRESHOLD=90
DAILY_FACE_CALL_CAP=5000

# UPI (later)
UPI_ID=
UPI_PAYEE_NAME=
