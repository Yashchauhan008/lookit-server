# Server
NODE_ENV=development
ENV=development
SERVICE_NAME=lookit-api
SERVER_PORT=3007
PORT=3007

# JWT
JWT_SECRET=change-me-lookit-jwt-secret

# Database — local docker postgres-18 mapped to host :5433
# Replace PASSWORD with your postgres-18 password
DATABASE_URL=postgres://postgres:PASSWORD@127.0.0.1:5433/lookit?sslmode=disable

# Redis (local)
REDIS_URL=redis://127.0.0.1:6379

# Logging
CONSOLE_LOG_LEVEL=debug
FILE_LOG_LEVEL=error

# SMTP (OTP + receipts)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Lookit <noreply@lookit.studio>

# File storage (dev path; R2 in later phase)
FILE_STORAGE_ENDPOINT=http://localhost:3007/files
FILE_STORAGE_PATH=./files

# AWS (backup bucket + later Rekognition)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BACKUP_BUCKET=

# App URLs
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3007
CORS_ORIGINS=http://localhost:5173

# Admin bootstrap
ADMIN_EMAIL=yashchauhan1775@gmail.com

# Face (Phase 1)
FACE_ENGINE=rekognition
FACE_MATCH_THRESHOLD=90
DAILY_FACE_CALL_CAP=5000

# UPI (later)
UPI_ID=
UPI_PAYEE_NAME=
