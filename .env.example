# Server
NODE_ENV=development
ENV=development
SERVICE_NAME=lookit-api
SERVER_PORT=3007
PORT=3007

# JWT
JWT_SECRET=change-me-lookit-jwt-secret

# Database — existing docker postgres-18 on host :5433 (same as orbit)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@127.0.0.1:5433/lookit?sslmode=disable

# Redis (local host)
REDIS_URL=redis://127.0.0.1:6379

# Logging
CONSOLE_LOG_LEVEL=debug
FILE_LOG_LEVEL=error

# SMTP — replace with real values later; dummy OK for local boot
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=dummy@lookit.studio
SMTP_PASSWORD=dummy-smtp-password
MAIL_FROM=Lookit <noreply@lookit.studio>

# File storage (dev path; R2 later)
FILE_STORAGE_ENDPOINT=http://localhost:3007/files
FILE_STORAGE_PATH=./files

# AWS placeholders (Rekognition / backup later)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_S3_BACKUP_BUCKET=lookit-backups-dev

# App URLs (prod: lookit.studio / api.lookit.studio)
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3007
CORS_ORIGINS=http://localhost:5173

# Admin bootstrap
ADMIN_EMAIL=yashchauhan1775@gmail.com

# Face (Phase 1)
FACE_ENGINE=rekognition
FACE_MATCH_THRESHOLD=90
DAILY_FACE_CALL_CAP=5000

# UPI (later)
UPI_ID=
UPI_PAYEE_NAME=
