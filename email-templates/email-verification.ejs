<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Verify your email</title>
    </head>

    <body
        style="
            font-family: 'Inter Tight', 'Helvetica Neue', Helvetica, Arial, sans-serif;
            background-color: #f6f6f8;
            margin: 0;
            padding: 0;
            color: #0d0d10;
        "
    >
        <div style="background-color: #f6f6f8; padding: 40px 16px">
            <div style="max-width: 560px; margin: 0 auto">
                <div style="text-align: center; margin-bottom: 24px">
                    <span style="font-size: 20px; font-weight: 700; letter-spacing: -0.02em; color: #0d0d10">
                        <span style="color: #ff6a2b">&#9679;</span> Lookit
                    </span>
                </div>

                <div
                    style="
                        background-color: #ffffff;
                        padding: 40px 32px;
                        border-radius: 28px;
                        box-shadow: 0 24px 60px -24px rgba(20, 20, 40, 0.22);
                    "
                >
                    <h1
                        style="
                            color: #0d0d10;
                            font-size: 28px;
                            line-height: 1.1;
                            font-weight: 600;
                            letter-spacing: -0.03em;
                            margin: 0 0 24px;
                        "
                    >
                        Verify your email
                    </h1>

                    <p style="font-size: 16px; line-height: 1.6; margin: 0 0 16px; color: #0d0d10">
                        Hello <strong><%= name %></strong>,
                    </p>

                    <p style="font-size: 16px; line-height: 1.6; margin: 0 0 28px; color: #7a7a84">
                        Thanks for creating your Lookit studio. Use this one-time password (OTP) to verify your email address. This code is valid for 5 minutes.
                    </p>

                    <div style="text-align: center; margin-bottom: 28px">
                        <div
                            style="
                                display: inline-block;
                                padding: 18px 36px;
                                background-color: #0d0d10;
                                border-radius: 999px;
                            "
                        >
                            <span
                                style="
                                    font-family: 'Courier New', Courier, monospace;
                                    font-size: 32px;
                                    font-weight: 700;
                                    letter-spacing: 8px;
                                    color: #ffffff;
                                "
                            >
                                <%= code %>
                            </span>
                        </div>
                    </div>

                    <p style="font-size: 14px; line-height: 1.6; color: #7a7a84; margin: 0">
                        If you didn't request this, you can safely ignore this email.
                    </p>
                </div>

                <p style="font-size: 12px; color: #a0a0aa; text-align: center; margin: 24px 0 0">
                    &copy; <%= new Date().getFullYear() %> Lookit. Event photos, found by face.
                </p>
            </div>
        </div>
    </body>
</html>
